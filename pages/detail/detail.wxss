.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.detail-status {
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
}

.detail-status.pending {
  background: #e8f2fe;
  color: #4A90D9;
}

.detail-status.picked {
  background: #f0fff0;
  color: #52c41a;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: #999;
}

.detail-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.code-value {
  font-size: 36rpx;
  color: #4A90D9;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.pick-btn {
  background: #52c41a;
  color: #fff;
}

.cancel-btn {
  background: #fff;
  color: #4A90D9;
  border: 2rpx solid #4A90D9;
}

.delete-btn {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
}