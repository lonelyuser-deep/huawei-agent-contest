<view class="container">
  <view class="smart-section">
    <view class="section-title">🤖 智能录入</view>
    <view class="smart-input-wrap">
      <textarea class="smart-input" placeholder="粘贴快递通知，或输入如：菜鸟驿站取件码1-3-201圆通尾号1234" value="{{rawInput}}" bindinput="onRawInput" auto-height maxlength="300"></textarea>
    </view>
    <button class="parse-btn" bindtap="parseText" type="primary" size="mini">智能识别</button>
  </view>

  <view class="form-section">
    <view class="section-title">📝 手动填写</view>

    <view class="form-item">
      <text class="form-label">驿站名称</text>
      <input class="form-input" placeholder="如：菜鸟驿站" value="{{form.station}}" bindinput="onInput" data-field="station"></input>
    </view>

    <view class="form-item">
      <text class="form-label">取件码</text>
      <input class="form-input" placeholder="如：1-3-201" value="{{form.code}}" bindinput="onInput" data-field="code"></input>
    </view>

    <view class="form-item">
      <text class="form-label">快递公司</text>
      <picker class="form-picker" mode="selector" range="{{couriers}}" value="{{courierIndex}}" bindchange="onCourierChange">
        <view class="picker-text {{courierIndex === 0 ? 'placeholder' : ''}}">{{couriers[courierIndex]}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">手机尾号</text>
      <input class="form-input" type="number" placeholder="后4位（选填）" value="{{form.phone}}" bindinput="onInput" data-field="phone" maxlength="4"></input>
    </view>
  </view>

  <button class="save-btn" bindtap="onSave" type="primary">保存</button>
</view>