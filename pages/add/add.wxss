.smart-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.smart-input-wrap {
  margin: 16rpx 0;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.smart-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.parse-btn {
  margin-top: 16rpx;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.form-picker {
  flex: 1;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
  padding: 8rpx 0;
}

.picker-text.placeholder {
  color: #999;
}

.save-btn {
  margin-top: 48rpx;
  width: 100%;
  border-radius: 12rpx;
}