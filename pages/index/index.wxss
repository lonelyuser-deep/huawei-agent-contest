.stats-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 0;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 56rpx;
  font-weight: 700;
}

.pending-color { color: #4A90D9; }
.picked-color { color: #52c41a; }

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #eee;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
  overflow: hidden;
}

.pending-card {
  border-left: 8rpx solid #4A90D9;
}

.picked-card {
  border-left: 8rpx solid #52c41a;
  opacity: 0.65;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-station {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.card-courier {
  font-size: 24rpx;
  color: #fff;
  background: #4A90D9;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.card-body {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.card-code {
  font-size: 28rpx;
  color: #555;
}

.card-phone {
  font-size: 24rpx;
  color: #999;
}

.card-action {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  font-size: 26rpx;
  color: #52c41a;
  padding: 8rpx 20rpx;
  border: 2rpx solid #52c41a;
  border-radius: 30rpx;
}

.toggle-title {
  display: flex;
  align-items: center;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #ccc;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: #4A90D9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74,144,217,0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
}