<view class="container">
  <view class="stats-bar">
    <view class="stat-item">
      <text class="stat-num pending-color">{{stats.pending}}</text>
      <text class="stat-label">待取件</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num picked-color">{{stats.picked}}</text>
      <text class="stat-label">已取件</text>
    </view>
  </view>

  <view class="section" wx:if="{{pendingList.length > 0}}">
    <view class="section-title">📦 待取件</view>
    <view class="card pending-card" wx:for="{{pendingList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="card-header">
        <text class="card-station">{{item.station || '未知驿站'}}</text>
        <text class="card-courier" wx:if="{{item.courier}}">{{item.courier}}</text>
      </view>
      <view class="card-body">
        <text class="card-code">取件码：{{item.code}}</text>
        <text class="card-phone" wx:if="{{item.phone}}">尾号 {{item.phone}}</text>
      </view>
      <view class="card-action" catchtap="quickPick" data-id="{{item.id}}">
        <text>✅ 已取</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{pendingList.length === 0 && pickedList.length === 0}}">
    <text class="empty-icon">📦</text>
    <text class="empty-text">还没有快递记录</text>
    <text class="empty-hint">点击右下角 + 添加快递</text>
  </view>

  <view class="section" wx:if="{{pickedList.length > 0}}">
    <view class="section-title toggle-title" bindtap="togglePicked">
      <text>✅ 已取件 ({{pickedList.length}}) {{showPicked ? '▲' : '▼'}}</text>
    </view>
    <block wx:if="{{showPicked}}">
      <view class="card picked-card" wx:for="{{pickedList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="card-header">
          <text class="card-station">{{item.station || '未知驿站'}}</text>
          <text class="card-courier" wx:if="{{item.courier}}">{{item.courier}}</text>
        </view>
        <view class="card-body">
          <text class="card-code">取件码：{{item.code}}</text>
        </view>
      </view>
    </block>
  </view>

  <view class="fab" bindtap="goAdd">
    <text class="fab-icon">+</text>
  </view>
</view>